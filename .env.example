PORT=3000

# ─── JWT ───────────────────────────────────────────────────
# 아래는 예시일 뿐입니다. 실제 배포 시에는 반드시 무작위의 긴 문자열로 직접 교체하세요.
# 생성 예: openssl rand -hex 64
JWT_SECRET=change_this_to_a_long_random_string

# ─── 어드민 / 직원 비밀번호 ───────────────────────────────
ADMIN_PASSWORD=change_this_admin_password
STAFF_PASSWORD=change_this_staff_password

# ─── MariaDB ─────────────────────────────────────────────
# MariaDB 설치 후:
#   CREATE DATABASE stamp_event CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'stamp_user'@'localhost' IDENTIFIED BY 'your_password';
#   GRANT ALL ON stamp_event.* TO 'stamp_user'@'localhost';
# 스키마 생성: npm run init-db
# 부스 초기화: npm run seed
DB_HOST=localhost
DB_PORT=3306
DB_USER=stamp_user
DB_PASSWORD=your_password
DB_NAME=stamp_event
